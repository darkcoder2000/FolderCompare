<Window x:Class="FolderCompare.App.Views.TextCompare.TextCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:FolderCompare.App.Views.TextCompare"
        Title="Text compare" Width="1200" Height="800" MinWidth="600" MinHeight="300"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="PaneHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StatusColumnBackground}" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style x:Key="Editor" TargetType="ae:TextEditor">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ShowLineNumbers" Value="True" />
            <Setter Property="WordWrap" Value="False" />
            <Setter Property="LineNumbersForeground" Value="#8A8A8A" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="ToolText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Save focused side" InputGestureText="Ctrl+S" Click="SaveFocused_Click" />
                <MenuItem x:Name="SaveLeftMenu" Header="Save _left" Click="SaveLeft_Click" />
                <MenuItem x:Name="SaveRightMenu" Header="Save _right" Click="SaveRight_Click" />
                <MenuItem Header="Save _all" InputGestureText="Ctrl+Shift+S" Click="SaveAll_Click" />
                <Separator />
                <MenuItem Header="Re_load files" InputGestureText="F5" Click="Reload_Click" />
                <Separator />
                <MenuItem Header="_Close" InputGestureText="Esc" Click="Close_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="Copy to _Right &#x2192;" InputGestureText="Ctrl+R" Click="CopyToRight_Click" />
                <MenuItem Header="&#x2190; Copy to _Left" InputGestureText="Ctrl+L" Click="CopyToLeft_Click" />
            </MenuItem>
            <MenuItem Header="_Search">
                <MenuItem Header="_Next difference" InputGestureText="Ctrl+N" Click="NextDiff_Click" />
                <MenuItem Header="_Previous difference" InputGestureText="Ctrl+P" Click="PrevDiff_Click" />
                <MenuItem Header="_First difference" Click="FirstDiff_Click" />
                <MenuItem Header="_Last difference" Click="LastDiff_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="IgnoreWhitespaceMenu" Header="Ignore _whitespace differences" IsCheckable="True" Click="Options_Changed" />
                <MenuItem x:Name="IgnoreCaseMenu" Header="Ignore _case differences" IsCheckable="True" Click="Options_Changed" />
                <Separator />
                <MenuItem x:Name="ShowWhitespaceMenu" Header="_Visible whitespace" IsCheckable="True" Click="ShowWhitespace_Changed" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Click="SaveFocused_Click" ToolTip="Save the focused side (Ctrl+S)">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F4BE;" Style="{StaticResource ToolText}" /><TextBlock Text="Save" Style="{StaticResource ToolText}" /></StackPanel>
                </Button>
                <Separator />
                <Button Click="Undo_Click" ToolTip="Undo in the focused side (Ctrl+Z)"><TextBlock Text="&#x21B6; Undo" Style="{StaticResource ToolText}" /></Button>
                <Button Click="Redo_Click" ToolTip="Redo in the focused side (Ctrl+Y)"><TextBlock Text="&#x21B7; Redo" Style="{StaticResource ToolText}" /></Button>
                <Separator />
                <Button x:Name="PrevButton" Click="PrevDiff_Click" ToolTip="Previous difference (Ctrl+P)"><TextBlock Text="&#x25B2; Prev" Style="{StaticResource ToolText}" /></Button>
                <Button x:Name="NextButton" Click="NextDiff_Click" ToolTip="Next difference (Ctrl+N)"><TextBlock Text="&#x25BC; Next" Style="{StaticResource ToolText}" /></Button>
                <Separator />
                <Button Click="CopyToRight_Click" ToolTip="Copy the current section to the right (Ctrl+R)"><TextBlock Text="Copy &#x2192;" Style="{StaticResource ToolText}" /></Button>
                <Button Click="CopyToLeft_Click" ToolTip="Copy the current section to the left (Ctrl+L)"><TextBlock Text="&#x2190; Copy" Style="{StaticResource ToolText}" /></Button>
                <Separator />
                <ToggleButton x:Name="IgnoreWhitespaceToggle" Click="Options_Changed" ToolTip="Treat whitespace-only differences as unimportant (blue)">
                    <TextBlock Text="Ignore whitespace" Style="{StaticResource ToolText}" />
                </ToggleButton>
                <ToggleButton x:Name="IgnoreCaseToggle" Click="Options_Changed" ToolTip="Treat case-only differences as unimportant (blue)">
                    <TextBlock Text="Ignore case" Style="{StaticResource ToolText}" />
                </ToggleButton>
                <Separator />
                <Button Click="Reload_Click" ToolTip="Reload both files from disk (F5)"><TextBlock Text="&#x27F3; Reload" Style="{StaticResource ToolText}" /></Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="DiffCountText" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="SectionText" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="CaretText" /></StatusBarItem>
        </StatusBar>

        <!-- Line details: the current line of both sides, one above the other -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="4,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="L " Foreground="#8A8A8A" FontFamily="Consolas" FontSize="13" />
                <TextBlock Grid.Row="1" Text="R " Foreground="#8A8A8A" FontFamily="Consolas" FontSize="13" />
                <TextBlock x:Name="LeftDetails" Grid.Column="1" FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="RightDetails" Grid.Column="1" Grid.Row="1" FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Column="1" Style="{StaticResource PaneHeader}">
                <DockPanel>
                    <TextBlock x:Name="LeftFormat" DockPanel.Dock="Right" Foreground="#6B6B6B" Margin="8,0,0,0" />
                    <TextBlock x:Name="LeftHeader" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource PaneHeader}">
                <DockPanel>
                    <TextBlock x:Name="RightFormat" DockPanel.Dock="Right" Foreground="#6B6B6B" Margin="8,0,0,0" />
                    <TextBlock x:Name="RightHeader" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <Border Grid.Column="0" Grid.ColumnSpan="1" Style="{StaticResource PaneHeader}" />
            <Border Grid.Column="2" Style="{StaticResource PaneHeader}" />

            <local:DiffOverviewBar x:Name="Overview" Grid.Row="1" Grid.Column="0" />
            <ae:TextEditor x:Name="LeftEditor" Grid.Row="1" Grid.Column="1" Style="{StaticResource Editor}" />
            <local:DiffCenterStrip x:Name="CenterStrip" Grid.Row="1" Grid.Column="2" />
            <ae:TextEditor x:Name="RightEditor" Grid.Row="1" Grid.Column="3" Style="{StaticResource Editor}" />
        </Grid>
    </DockPanel>
</Window>
