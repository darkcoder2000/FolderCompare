<Window x:Class="FolderCompare.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,10,4" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <GroupBox Header="Comparison" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Timestamp _tolerance (seconds):" />
                <TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4"
                         Text="{Binding ToleranceSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Ignore exactly ±1 hour differences (_DST / time zone)" IsChecked="{Binding IgnoreDstOffset}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Symbolic links / junctions:" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SymlinkCombo" Width="120" HorizontalAlignment="Left" Margin="0,4" SelectedItem="{Binding SymlinkMode}" />
                <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Ignore _hidden and system files" IsChecked="{Binding IgnoreHiddenAndSystem}" />
                <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Compare sub_folders (recursive)" IsChecked="{Binding Recursive}" />
                <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="_Exclude patterns:" />
                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding ExcludePatterns}" ToolTip="e.g. *.tmp;.git;node_modules;bin;obj" />
                <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="_Include patterns:" />
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Text="{Binding IncludePatterns}" ToolTip="Empty = all files" />
            </Grid>
        </GroupBox>

        <GroupBox Header="File operations" Padding="8,4" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="_Overwrite policy:" />
                <ComboBox Grid.Column="1" x:Name="OverwriteCombo" Width="160" HorizontalAlignment="Left" Margin="0,4" SelectedItem="{Binding OverwritePolicy}" />
                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Delete to the _Recycle Bin (unchecked = delete permanently)" IsChecked="{Binding DeleteToRecycleBin}" />
                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="_Confirm Recycle Bin deletes" IsChecked="{Binding ConfirmRecycleDelete}" />
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Skip copy _preview for fewer than (items):" />
                <TextBox Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4"
                         Text="{Binding PreviewThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                         ToolTip="0 = always show the preview" />
            </Grid>
        </GroupBox>

        <GroupBox Header="View" Padding="8,4" Margin="0,10,0,0">
            <CheckBox Content="Sort _folders before files" IsChecked="{Binding FoldersFirst}" />
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_OK" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click" />
            <Button Content="_Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
