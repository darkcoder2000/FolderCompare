<Window x:Class="FolderCompare.App.Views.DeleteSideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="Some selected items exist on both sides. Which side should be deleted?" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Left" Style="{StaticResource DialogButton}" Click="Left_Click" />
            <Button Content="_Right" Style="{StaticResource DialogButton}" Click="Right_Click" />
            <Button Content="_Both" Style="{StaticResource DialogButton}" Click="Both_Click" />
            <Button Content="_Cancel" Style="{StaticResource DialogButton}" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
