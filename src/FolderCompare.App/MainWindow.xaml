<Window x:Class="FolderCompare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FolderCompare.App.ViewModels"
        xmlns:views="clr-namespace:FolderCompare.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="FolderCompare" Width="1280" Height="780" MinWidth="700" MinHeight="400"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded" Closing="Window_Closing">

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Compare / Refresh" Command="{Binding CompareCommand}" InputGestureText="F5" />
                <MenuItem Header="Rescan _selected" Command="{Binding RefreshSelectedCommand}" />
                <MenuItem Header="_Export report..." Command="{Binding ExportReportCommand}" InputGestureText="Ctrl+E" />
                <Separator />
                <MenuItem Header="Open _log folder" Command="{Binding OpenLogFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Expand all" Command="{Binding ExpandAllCommand}" />
                <MenuItem Header="_Collapse all" Command="{Binding CollapseAllCommand}" />
                <Separator />
                <MenuItem Header="_Folders before files" IsCheckable="True" IsChecked="{Binding FoldersFirst}" />
            </MenuItem>
            <MenuItem Header="_Profiles">
                <MenuItem Header="_Save current as profile..." Command="{Binding SaveProfileCommand}" />
                <MenuItem Header="_Delete selected profile" Command="{Binding DeleteProfileCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings..." Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
        </Menu>

        <!-- Folder bar -->
        <Grid DockPanel.Dock="Top" Margin="6,6,6,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox Grid.Column="0" x:Name="LeftPathBox" IsEditable="True" Tag="Left" AllowDrop="True"
                      ItemsSource="{Binding RecentPaths}" Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="Left folder" ToolTip="Left folder (type, paste or drop a folder)"
                      PreviewDragOver="PathBox_PreviewDragOver" PreviewDrop="PathBox_PreviewDrop" Padding="4,3" />
            <Button Grid.Column="1" Content="..." Width="30" Margin="3,0,0,0" ToolTip="Browse for the left folder"
                    Command="{Binding BrowseCommand}" CommandParameter="Left" />
            <Button Grid.Column="2" Content="&#x21C4;" Width="34" Margin="8,0" FontSize="14" ToolTip="Swap left and right"
                    Command="{Binding SwapCommand}" />
            <ComboBox Grid.Column="3" x:Name="RightPathBox" IsEditable="True" Tag="Right" AllowDrop="True"
                      ItemsSource="{Binding RecentPaths}" Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="Right folder" ToolTip="Right folder (type, paste or drop a folder)"
                      PreviewDragOver="PathBox_PreviewDragOver" PreviewDrop="PathBox_PreviewDrop" Padding="4,3" />
            <Button Grid.Column="4" Content="..." Width="30" Margin="3,0,0,0" ToolTip="Browse for the right folder"
                    Command="{Binding BrowseCommand}" CommandParameter="Right" />
            <Button Grid.Column="5" Content="_Compare" Margin="8,0,0,0" Padding="14,2" FontWeight="SemiBold"
                    ToolTip="Compare / refresh (F5)" Command="{Binding CompareCommand}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LeftPathError}" Foreground="{DynamicResource ErrorBrush}"
                       Visibility="{Binding LeftPathError, Converter={StaticResource NullToCollapsed}}" Margin="2,2,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding RightPathError}" Foreground="{DynamicResource ErrorBrush}"
                       Visibility="{Binding RightPathError, Converter={StaticResource NullToCollapsed}}" Margin="2,2,0,0" />
        </Grid>

        <Border DockPanel.Dock="Top" Background="{DynamicResource MessageBarBackground}" Padding="8,4" Margin="6,2"
                Visibility="{Binding RootError, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding RootError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <TextBlock Text="Show:" VerticalAlignment="Center" Margin="2,0,4,0" />
                <ToggleButton Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowOnlyLeft}" ToolTip="Show items that exist only on the left">
                    <TextBlock Text="Only left" Foreground="{DynamicResource OnlyBrush}" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowNewerLeft}" ToolTip="Show items that are newer on the left">
                    <TextBlock Text="Newer left" Foreground="{DynamicResource NewerBrush}" FontWeight="Bold" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowIdentical}" ToolTip="Show identical items" Content="Identical" />
                <ToggleButton Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowNewerRight}" ToolTip="Show items that are newer on the right">
                    <TextBlock Text="Newer right" Foreground="{DynamicResource NewerBrush}" FontWeight="Bold" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowOnlyRight}" ToolTip="Show items that exist only on the right">
                    <TextBlock Text="Only right" Foreground="{DynamicResource OnlyBrush}" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowErrors}" ToolTip="Show errors and file/folder conflicts">
                    <TextBlock Text="Errors" Foreground="{DynamicResource ErrorBrush}" />
                </ToggleButton>
                <Separator />
                <ToggleButton Style="{StaticResource FilterToggle}" IsChecked="{Binding DifferencesOnly}" Content="Differences only"
                              ToolTip="Hide identical items and folders without differences" />
                <Separator />
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="4,0" />
                <TextBox x:Name="SearchBox" Width="160" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search" ToolTip="Filter by file or folder name (Ctrl+F)" VerticalContentAlignment="Center" />
            </ToolBar>
            <ToolBar>
                <Button Command="{Binding CopyToRightCommand}" ToolTip="Copy selection to the right (Ctrl+Right)" Content="Copy &#x2192;" />
                <Button Command="{Binding CopyToLeftCommand}" ToolTip="Copy selection to the left (Ctrl+Left)" Content="&#x2190; Copy" />
                <Button Command="{Binding DeleteCommand}" ToolTip="Delete selection (Del)" Content="Delete" />
                <Separator />
                <Button Command="{Binding CompareCommand}" ToolTip="Rescan (F5)" Content="Refresh" />
                <Button Command="{Binding ExpandAllCommand}" ToolTip="Expand all folders" Content="Expand all" />
                <Button Command="{Binding CollapseAllCommand}" ToolTip="Collapse all folders" Content="Collapse all" />
                <Button Command="{Binding OpenSettingsCommand}" ToolTip="Settings" Content="Options" />
            </ToolBar>
            <ToolBar Band="1">
                <TextBlock Text="Exclude:" VerticalAlignment="Center" Margin="2,0,4,0" />
                <TextBox Width="220" Text="{Binding ExcludePatterns, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Exclude patterns" ToolTip="Glob patterns to skip, separated by ';' (e.g. *.tmp;.git;node_modules;bin;obj). Applied on the next scan." />
                <TextBlock Text="Include:" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox Width="140" Text="{Binding IncludePatterns, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Include patterns" ToolTip="Only compare files matching these patterns, separated by ';' (empty = all files). Applied on the next scan." />
                <Separator />
                <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox Width="160" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                          AutomationProperties.Name="Profile" ToolTip="Load a saved folder pair with its options" />
                <Button Command="{Binding SaveProfileCommand}" Content="Save" ToolTip="Save the current folders and options as a profile" />
                <Button Command="{Binding DeleteProfileCommand}" Content="Remove" ToolTip="Delete the selected profile" />
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
                <Button Content="Cancel (Esc)" Command="{Binding CancelCommand}" Padding="8,0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding IsOperating, Converter={StaticResource BoolToVisible}}">
                <ProgressBar Width="80" Height="12" Value="{Binding FileProgressValue}" ToolTip="Current file" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
                <ProgressBar Width="160" Height="12" Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}" ToolTip="Overall progress" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding CountsText}" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Left" />
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding SelectionText}" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Left" />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- Side-by-side tree grid: one row per relative path -->
        <views:TreeListView x:Name="ResultList" ItemsSource="{Binding Rows}" SelectionMode="Extended"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True"
                            ScrollViewer.IsDeferredScrollingEnabled="False"
                            AutomationProperties.Name="Comparison results"
                            SelectionChanged="ResultList_SelectionChanged" PreviewKeyDown="ResultList_PreviewKeyDown"
                            MouseDoubleClick="ResultList_MouseDoubleClick"
                            GridViewColumnHeader.Click="ResultList_HeaderClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                    <Setter Property="Padding" Value="0,1" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy to _Right &#x2192;" Command="{Binding CopyToRightCommand}" InputGestureText="Ctrl+Right" />
                    <MenuItem Header="&#x2190; Copy to _Left" Command="{Binding CopyToLeftCommand}" InputGestureText="Ctrl+Left" />
                    <Separator />
                    <MenuItem Header="Delete Left" Command="{Binding DeleteLeftCommand}" />
                    <MenuItem Header="Delete Right" Command="{Binding DeleteRightCommand}" />
                    <MenuItem Header="Delete Both" Command="{Binding DeleteBothCommand}" />
                    <Separator />
                    <MenuItem Header="Re_name..." Command="{Binding RenameCommand}" InputGestureText="F2" />
                    <MenuItem Header="_Open">
                        <MenuItem Header="Left" Command="{Binding OpenCommand}" CommandParameter="Left" />
                        <MenuItem Header="Right" Command="{Binding OpenCommand}" CommandParameter="Right" />
                    </MenuItem>
                    <MenuItem Header="Open containing _folder">
                        <MenuItem Header="Left" Command="{Binding OpenContainingFolderCommand}" CommandParameter="Left" />
                        <MenuItem Header="Right" Command="{Binding OpenContainingFolderCommand}" CommandParameter="Right" />
                    </MenuItem>
                    <MenuItem Header="Show in _Explorer">
                        <MenuItem Header="Left" Command="{Binding ShowInExplorerCommand}" CommandParameter="Left" />
                        <MenuItem Header="Right" Command="{Binding ShowInExplorerCommand}" CommandParameter="Right" />
                    </MenuItem>
                    <MenuItem Header="Copy full _path">
                        <MenuItem Header="Left" Command="{Binding CopyPathCommand}" CommandParameter="Left" />
                        <MenuItem Header="Right" Command="{Binding CopyPathCommand}" CommandParameter="Right" />
                        <MenuItem Header="Both" Command="{Binding CopyPathCommand}" CommandParameter="Both" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Select all newer on left" Command="{Binding SelectByStatusCommand}" CommandParameter="NewerLeft" />
                    <MenuItem Header="Select all newer on right" Command="{Binding SelectByStatusCommand}" CommandParameter="NewerRight" />
                    <MenuItem Header="Select all only-left" Command="{Binding SelectByStatusCommand}" CommandParameter="OnlyLeft" />
                    <MenuItem Header="Select all only-right" Command="{Binding SelectByStatusCommand}" CommandParameter="OnlyRight" />
                    <MenuItem Header="Invert selection" Command="{Binding InvertSelectionCommand}" />
                    <Separator />
                    <MenuItem Header="Expand subtree" Command="{Binding ExpandSubtreeCommand}" />
                    <MenuItem Header="Collapse subtree" Command="{Binding CollapseSubtreeCommand}" />
                    <MenuItem Header="Rescan selected" Command="{Binding RefreshSelectedCommand}" />
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="320">
                        <GridViewColumnHeader Tag="Name" Content="Left name" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                    <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded}"
                                                  Visibility="{Binding IsExpandable, Converter={StaticResource BoolToHidden}}" />
                                    <Grid Width="20">
                                        <TextBlock Style="{StaticResource IconText}" Text="{Binding LeftIcon}" />
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource DiffMarkerBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Visibility="{Binding ShowDiffMarker, Converter={StaticResource BoolToVisible}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding LeftName}" Style="{StaticResource LeftSideText}" Margin="4,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="80">
                        <GridViewColumnHeader Tag="LeftSize" Content="Size" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftSize}" Style="{StaticResource LeftSideText}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="135">
                        <GridViewColumnHeader Tag="LeftDate" Content="Modified" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftDate}" Style="{StaticResource LeftSideText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="36">
                        <GridViewColumnHeader Tag="Status" Content="" ToolTip="Status" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="320">
                        <GridViewColumnHeader Tag="Name" Content="Right name" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                    <Grid Width="16" />
                                    <Grid Width="20">
                                        <TextBlock Style="{StaticResource IconText}" Text="{Binding RightIcon}" />
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource DiffMarkerBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Visibility="{Binding ShowDiffMarker, Converter={StaticResource BoolToVisible}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding RightName}" Style="{StaticResource RightSideText}" Margin="4,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="80">
                        <GridViewColumnHeader Tag="RightSize" Content="Size" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightSize}" Style="{StaticResource RightSideText}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="135">
                        <GridViewColumnHeader Tag="RightDate" Content="Modified" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightDate}" Style="{StaticResource RightSideText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </views:TreeListView>
    </DockPanel>
</Window>
