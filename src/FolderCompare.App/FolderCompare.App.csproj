<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FolderCompare</AssemblyName>
    <RootNamespace>FolderCompare.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <Product>FolderCompare</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file, self-contained publish: dotnet publish src/FolderCompare.App -c Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- Native Explorer context menu handler (C++, needs the MSVC Build Tools), embedded and extracted on Register. -->
  <PropertyGroup>
    <ShellExtDir>$(MSBuildThisFileDirectory)..\FolderCompare.ShellExt\</ShellExtDir>
    <ShellExtDll>$(ShellExtDir)bin\x64\FolderCompare.ShellExt.dll</ShellExtDll>
  </PropertyGroup>

  <ItemGroup>
    <ShellExtSource Include="$(ShellExtDir)ShellExt.cpp;$(ShellExtDir)ShellExt.def;$(ShellExtDir)build.ps1" />
    <EmbeddedResource Include="$(ShellExtDll)" LogicalName="FolderCompare.ShellExt.dll" Link="ShellExt\FolderCompare.ShellExt.dll" />
  </ItemGroup>

  <Target Name="BuildShellExt" BeforeTargets="BeforeBuild;PrepareForBuild" Inputs="@(ShellExtSource)" Outputs="$(ShellExtDll)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ShellExtDir)build.ps1&quot;" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\FolderCompare.Core\FolderCompare.Core.csproj" />
  </ItemGroup>

</Project>
