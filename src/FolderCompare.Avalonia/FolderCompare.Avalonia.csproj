<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform UI (Windows, Linux, macOS). Replaces the WPF app (FolderCompare.App) once it reaches parity. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FolderCompare</AssemblyName>
    <RootNamespace>FolderCompare.App</RootNamespace>
    <Version>2.0.0</Version>
    <Product>FolderCompare</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!--
    Publish per OS, e.g.
    dotnet publish src/FolderCompare.Avalonia -c Release -r win-x64 -o publish/win-x64
    (linux-x64, osx-arm64, osx-x64 likewise). The RID is never fixed here.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderCompare.Core\FolderCompare.Core.csproj" />
  </ItemGroup>

  <!--
    Native Explorer context menu handler (C++, needs the MSVC Build Tools), embedded and extracted on Register.
    Windows builds only: Linux and macOS builds (and their RIDs) neither need MSVC nor carry the DLL.
  -->
  <PropertyGroup>
    <ShellExtDir>$(MSBuildThisFileDirectory)..\FolderCompare.ShellExt\</ShellExtDir>
    <ShellExtDll>$(ShellExtDir)bin\x64\FolderCompare.ShellExt.dll</ShellExtDll>
    <WithShellExt Condition="$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64')">true</WithShellExt>
  </PropertyGroup>

  <ItemGroup Condition="'$(WithShellExt)' == 'true'">
    <ShellExtSource Include="$(ShellExtDir)ShellExt.cpp;$(ShellExtDir)ShellExt.def;$(ShellExtDir)build.ps1" />
    <EmbeddedResource Include="$(ShellExtDll)" LogicalName="FolderCompare.ShellExt.dll" Link="ShellExt\FolderCompare.ShellExt.dll" />
  </ItemGroup>

  <Target Name="BuildShellExt" BeforeTargets="BeforeBuild;PrepareForBuild" Condition="'$(WithShellExt)' == 'true'"
          Inputs="@(ShellExtSource)" Outputs="$(ShellExtDll)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ShellExtDir)build.ps1&quot;" />
  </Target>

</Project>
