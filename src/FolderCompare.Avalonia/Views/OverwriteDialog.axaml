<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FolderCompare.App.Views.OverwriteDialog"
        Title="File already exists" SizeToContent="WidthAndHeight" MaxWidth="900" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico">
    <StackPanel Margin="14">
        <Border x:Name="NewerWarning" Background="{DynamicResource WarningBarBackground}" Padding="8,6" Margin="0,0,0,10" IsVisible="False">
            <TextBlock Foreground="{DynamicResource ErrorBrush}" FontWeight="Bold" TextWrapping="Wrap"
                       Text="Warning: the destination file is NEWER than the source. Overwriting it replaces the newer version - is the copy direction correct?" />
        </Border>
        <Border x:Name="UnknownWarning" Background="{DynamicResource WarningBarBackground}" Padding="8,6" Margin="0,0,0,10" IsVisible="False">
            <TextBlock Foreground="{DynamicResource ConflictBrush}" FontWeight="Bold" TextWrapping="Wrap"
                       Text="Both files have the same timestamp but different content, so it is unknown which one is newer. Compare the contents before overwriting." />
        </Border>
        <TextBlock Text="The destination already contains this file:" Margin="0,0,0,8" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="Source:" FontWeight="SemiBold" Margin="0,0,10,0" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SourcePath" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SourceInfo" Foreground="{DynamicResource OlderBrush}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Text="Destination:" FontWeight="SemiBold" Margin="0,0,10,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TargetPath" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TargetInfo" Foreground="{DynamicResource OlderBrush}" />
        </Grid>
        <CheckBox x:Name="ApplyToAll" Content="_Apply to all remaining conflicts" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OverwriteButton" Content="_Overwrite" Classes="dialog" Click="Overwrite_Click" />
            <Button Content="Overwrite if _newer" Classes="dialog" Click="OverwriteIfNewer_Click" />
            <Button Content="_Keep both" Classes="dialog" Click="KeepBoth_Click" />
            <Button x:Name="SkipButton" Content="_Skip" Classes="dialog" Click="Skip_Click" />
            <Button Content="Cancel all" Classes="dialog" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
