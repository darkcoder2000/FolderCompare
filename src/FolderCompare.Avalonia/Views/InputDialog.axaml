<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FolderCompare.App.Views.InputDialog"
        Title="Input" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6" />
        <TextBox x:Name="ValueBox" />
        <StackPanel x:Name="SidePanel" Orientation="Horizontal" Margin="0,10,0,0" IsVisible="False">
            <TextBlock Text="Rename on:" Margin="0,0,10,0" VerticalAlignment="Center" />
            <CheckBox x:Name="LeftCheck" Content="_Left" Margin="0,0,14,0" />
            <CheckBox x:Name="RightCheck" Content="_Right" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_OK" IsDefault="True" Classes="dialog" Click="Ok_Click" />
            <Button Content="_Cancel" IsCancel="True" Classes="dialog" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
