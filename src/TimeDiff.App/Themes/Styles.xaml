<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TimeDiff.App.ViewModels"
                    xmlns:conv="clr-namespace:TimeDiff.App.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <conv:BoolToVisibilityConverter x:Key="BoolToHidden" UseHidden="True" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />

    <!-- Side cell text: colored by the side state of the row. -->
    <Style x:Key="SideTextBase" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="LeftSideText" TargetType="TextBlock" BasedOn="{StaticResource SideTextBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding LeftState}" Value="{x:Static vm:SideState.Newer}">
                <Setter Property="Foreground" Value="{DynamicResource NewerBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LeftState}" Value="{x:Static vm:SideState.Older}">
                <Setter Property="Foreground" Value="{DynamicResource OlderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LeftState}" Value="{x:Static vm:SideState.Only}">
                <Setter Property="Foreground" Value="{DynamicResource OnlyBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LeftState}" Value="{x:Static vm:SideState.Error}">
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RightSideText" TargetType="TextBlock" BasedOn="{StaticResource SideTextBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RightState}" Value="{x:Static vm:SideState.Newer}">
                <Setter Property="Foreground" Value="{DynamicResource NewerBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RightState}" Value="{x:Static vm:SideState.Older}">
                <Setter Property="Foreground" Value="{DynamicResource OlderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RightState}" Value="{x:Static vm:SideState.Only}">
                <Setter Property="Foreground" Value="{DynamicResource OnlyBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RightState}" Value="{x:Static vm:SideState.Error}">
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource FileIconBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Node.IsDirectory}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource FolderIconBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Node.Status}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Node.Status}" Value="TypeConflict">
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Small triangle used to expand/collapse folders. -->
    <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 4 4 L 0 8 Z" Fill="#707070" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Data" Value="M 0 4 L 8 4 L 4 8 Z" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="#1F5FBF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="1,0" />
    </Style>

    <Style x:Key="DialogButton" TargetType="Button">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
</ResourceDictionary>
