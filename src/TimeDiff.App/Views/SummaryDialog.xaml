<Window x:Class="TimeDiff.App.Views.SummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Summary" Width="760" Height="420" MinWidth="400" MinHeight="220"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Copy report to _clipboard" Style="{StaticResource DialogButton}" Click="Copy_Click" />
            <Button Content="_Close" IsDefault="True" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
        <TextBox x:Name="ReportText" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AutomationProperties.Name="Report" />
    </DockPanel>
</Window>
